---

<section id="HowA" class="relative bg-primary-dark" style="height: 200vh;">

  <div class="sticky top-0 h-screen flex flex-col items-center justify-center overflow-hidden px-8">

    <h2 class="font-heading text-4xl md:text-5xl font-light text-premium-neutral tracking-tight text-center mb-4">
      Cómo diseñamos el viaje
    </h2>

    <div class="hidden md:block w-full max-w-5xl">
      <svg id="alt-svg" viewBox="0 0 900 270" xmlns="http://www.w3.org/2000/svg" class="w-full overflow-visible">

        <path d="M 70,235 C 150,215 185,220 270,188 C 355,156 375,178 455,138 C 535,98 562,120 645,74 C 710,38 775,48 850,22"
          fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="3" stroke-dasharray="8 6"/>

        <path id="alt-path"
          d="M 70,235 C 150,215 185,220 270,188 C 355,156 375,178 455,138 C 535,98 562,120 645,74 C 710,38 775,48 850,22"
          fill="none" stroke="#A46B3C" stroke-width="2.5" opacity="0.6" stroke-linecap="round"/>

        <!-- Destination TOP RIGHT -->
        <circle id="alt-dest-glow" cx="850" cy="22" r="44" fill="#A46B3C" opacity="0"/>
        <circle cx="850" cy="22" r="26" fill="#0E1A26" stroke="rgba(164,107,60,0.2)" stroke-width="2"/>
        <circle id="alt-dest-ring" cx="850" cy="22" r="26" fill="none" stroke="#A46B3C" stroke-width="2" opacity="0" style="transition: opacity 0.8s;"/>
        <text x="850" y="30" text-anchor="middle" font-size="18" fill="#A46B3C" opacity="0.2" id="alt-flag-dim">⚑</text>
        <text x="850" y="30" text-anchor="middle" font-size="18" fill="#A46B3C" id="alt-flag-bright" style="opacity:0; transition: opacity 0.8s;">⚑</text>

        <!-- Callout 1 — CENTER TOP, visible from start -->
        <g id="alt-s1" style="opacity:1; transition: opacity 0.8s ease;">
          <foreignObject x="330" y="2" width="240" height="60">
            <div xmlns="http://www.w3.org/1999/xhtml" style="display:flex; flex-direction:column; align-items:center; gap:5px;">
              <div style="display:flex; align-items:center; gap:8px;">
                <div style="width:24px; height:24px; border-radius:50%; background:transparent; border:1.5px solid var(--color-signature-accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                  <span style="color:var(--color-signature-accent); font-size:11px; font-weight:700; font-family:sans-serif;">1</span>
                </div>
                <span style="color:#F4F1EC; font-size:20px; font-weight:700; font-family:'Cormorant Garant',serif; color:var(--color-signature-accent);">Diagnóstico</span>
              </div>
              <span style="color:rgba(244,241,236,0.6); font-size:16px; font-style:italic; font-family:'Cormorant Garant',serif; font-weight:300;">Entendemos tus objetivos</span>
            </div>
          </foreignObject>
        </g>

        <!-- Car -->
        <g id="alt-car" style="opacity:0; transition: opacity 0.6s ease;">
          <rect x="-28" y="-10" width="56" height="18" rx="5" fill="#A46B3C" opacity="0.9"/>
          <rect x="-14" y="-22" width="32" height="15" rx="3" fill="#A46B3C" opacity="0.55"/>
          <circle cx="-16" cy="10" r="7" fill="#0E1A26" stroke="#A46B3C" stroke-width="2"/>
          <circle cx="18" cy="10" r="7" fill="#0E1A26" stroke="#A46B3C" stroke-width="2"/>
        </g>

        <!-- Callout 2 — MIDDLE LEFT, phase 2 -->
        <g id="alt-s2" style="opacity:0; transition: opacity 0.8s ease;">
          <foreignObject x="75" y="100" width="240" height="60">
            <div xmlns="http://www.w3.org/1999/xhtml" style="display:flex; flex-direction:column; align-items:center; gap:5px;">
              <div style="display:flex; align-items:center; gap:8px;">
                <div style="width:24px; height:24px; border-radius:50%; background:transparent; border:1.5px solid var(--color-signature-accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                  <span style="color:var(--color-signature-accent); font-size:11px; font-weight:700; font-family:sans-serif;">2</span>
                </div>
                <span style="color:#F4F1EC; font-size:20px; font-weight:700; font-family:'Cormorant Garant',serif; color:var(--color-signature-accent);">Estrategia</span>
              </div>
              <span style="color:rgba(244,241,236,0.6); font-size:16px; font-style:italic; font-family:'Cormorant Garant',serif; font-weight:300;">Diseñamos el viaje</span>
            </div>
          </foreignObject>
        </g>

        <!-- Callout 3 — BOTTOM RIGHT, phase 3 -->
        <g id="alt-s3" style="opacity:0; transition: opacity 0.8s ease;">
          <foreignObject x="610" y="175" width="240" height="60">
            <div xmlns="http://www.w3.org/1999/xhtml" style="display:flex; flex-direction:column; align-items:center; gap:5px;">
              <div style="display:flex; align-items:center; gap:8px;">
                <div style="width:24px; height:24px; border-radius:50%; background:transparent; border:1.5px solid var(--color-signature-accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                  <span style="color:var(--color-signature-accent); font-size:11px; font-weight:700; font-family:sans-serif;">3</span>
                </div>
                <span style="color:#F4F1EC; font-size:20px; font-weight:700; font-family:'Cormorant Garant',serif; color:var(--color-signature-accent);">Ejecución y seguimiento</span>
              </div>
              <span style="color:rgba(244,241,236,0.6); font-size:16px; font-style:italic; font-family:'Cormorant Garant',serif; font-weight:300;">Manejamos al destino</span>
            </div>
          </foreignObject>
        </g>

      </svg>
    </div>

    <!-- Mobile -->
    <div class="md:hidden w-full max-w-sm">
      <div class="flex flex-col divide-y divide-white/8">
        <div class="flex items-start gap-5 py-6">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-premium-neutral flex items-center justify-center">
            <span class="text-primary-dark text-sm font-medium">1</span>
          </div>
          <div>
            <p class="font-heading text-xl font-bold text-premium-neutral">Diagnóstico</p>
            <p class="text-premium-neutral/60 text-base italic mt-1">Entendemos tus objetivos</p>
          </div>
        </div>
        <div class="flex items-start gap-5 py-6">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-premium-neutral flex items-center justify-center">
            <span class="text-primary-dark text-sm font-medium">2</span>
          </div>
          <div>
            <p class="font-heading text-xl font-bold text-premium-neutral">Estrategia</p>
            <p class="text-premium-neutral/60 text-base italic mt-1">Diseñamos el viaje</p>
          </div>
        </div>
        <div class="flex items-start gap-5 py-6">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-premium-neutral flex items-center justify-center">
            <span class="text-primary-dark text-sm font-medium">3</span>
          </div>
          <div>
            <p class="font-heading text-xl font-bold text-premium-neutral">Ejecución y seguimiento</p>
            <p class="text-premium-neutral/60 text-base italic mt-1">Manejamos al destino</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const section    = document.getElementById('HowA');
    const pathEl     = document.getElementById('alt-path');
    const destGlow   = document.getElementById('alt-dest-glow');
    const destRing   = document.getElementById('alt-dest-ring');
    const flagDim    = document.getElementById('alt-flag-dim');
    const flagBright = document.getElementById('alt-flag-bright');
    const car  = document.getElementById('alt-car');
    const s1   = document.getElementById('alt-s1');
    const s2   = document.getElementById('alt-s2');
    const s3   = document.getElementById('alt-s3');

    let pathLength = 0;
    let carSmooth  = 0;
    let carTarget  = 0;
    let rafId      = null;

    function init() {
      if (!pathEl) return;
      pathLength = pathEl.getTotalLength();
      pathEl.setAttribute('stroke-dasharray', String(pathLength));
      pathEl.setAttribute('stroke-dashoffset', String(pathLength));
    }

    function lerp(a, b, t) { return a + (b - a) * Math.min(1, Math.max(0, t)); }
    function ph(p, s, e)   { return Math.min(1, Math.max(0, (p - s) / (e - s))); }

    function applyCarPos(dist) {
      if (!pathEl || !car || !pathLength) return;
      const pt  = pathEl.getPointAtLength(dist);
      const pt2 = pathEl.getPointAtLength(Math.min(dist + 12, pathLength));
      // Going right-upward — just rotate by tangent angle
      const angle = Math.atan2(pt2.y - pt.y, pt2.x - pt.x) * 180 / Math.PI;
      car.setAttribute('transform', `translate(${pt.x},${pt.y}) rotate(${angle})`);
    }

    function animateCar() {
      const delta = carTarget - carSmooth;
      carSmooth += delta * 0.06;
      applyCarPos(carSmooth);
      if (Math.abs(delta) > 0.5) {
        rafId = requestAnimationFrame(animateCar);
      } else {
        rafId = null;
      }
    }

    function update() {
      if (!section) return;
      const rect       = section.getBoundingClientRect();
      const scrollable = section.offsetHeight - window.innerHeight;
      const p          = Math.max(0, Math.min(1, -rect.top / scrollable));

      // Phase 1: destination activates
      const p1 = ph(p, 0.05, 0.32);
      if (destGlow)    destGlow.setAttribute('opacity',  String(lerp(0, 0.14, p1)));
      if (destRing)    destRing.setAttribute('opacity',  String(lerp(0, 1, p1)));
      if (flagDim)     flagDim.setAttribute('opacity',   String(lerp(0.2, 0, p1)));
      if (flagBright)  flagBright.style.opacity = String(lerp(0, 1, p1));

      // Phase 2: route draws + car appears
      const p2 = ph(p, 0.32, 0.65);
      if (pathEl && pathLength) pathEl.setAttribute('stroke-dashoffset', String(pathLength * (1 - p2)));
      if (car) car.style.opacity = p > 0.34 ? '1' : '0';

      // Phase 3: car travels — smooth via rAF
      const p3 = ph(p, 0.65, 0.97);
      carTarget = p3 > 0 ? pathLength * p3 : 0;
      if (!rafId) rafId = requestAnimationFrame(animateCar);

      // Callout fade: active step full, previous step dimmed
      const p2enter = ph(p, 0.38, 0.50);
      const p3enter = ph(p, 0.63, 0.73);
      if (s1) s1.style.opacity = String(lerp(1, 0.18, p2enter));
      if (s2) s2.style.opacity = String(lerp(lerp(0, 1, p2enter), 0.18, p3enter));
      if (s3) s3.style.opacity = String(lerp(0, 1, p3enter));
    }

    init();
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
