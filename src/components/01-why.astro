---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-2.jpg';
---

<section class="pt-20 pb-10 md:pt-28 md:pb-12 overflow-hidden relative">
  <div class="container-custom relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-lg">

        <!-- Persona content -->
        <div id="hero-persona">
          <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-relaxed tracking-tight">
            Tus objetivos<br />son el destino
          </h1>
          <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-normal tracking-tight mt-8">
            <span class="text-premium-neutral" style="background-color: #0E1A26; padding: 2px 10px 6px; box-decoration-break: clone; -webkit-box-decoration-break: clone;">Nosotros te ayudamos a llegar</span>
          </h2>
        </div>

        <!-- Empresa content -->
        <div id="hero-empresa" class="hidden">
          <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-tight tracking-tight">
            Tu empresa<br />genera valor
          </h1>
          <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-light leading-tight tracking-tight mt-4">
            <span class="text-premium-neutral" style="background-color: #0E1A26; padding: 2px 10px 6px; box-decoration-break: clone; -webkit-box-decoration-break: clone;">La estructura financiera no debería frenarlo</span>
          </h2>
        </div>
      </div>

      <div>
        <div class="relative hover-zoom">
          <div class="relative rounded-xl overflow-hidden">
            <Image
              src={heroImage}
              alt="Ambar Capital Partners"
              class="w-full h-auto"
              width={700}
              height={500}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

