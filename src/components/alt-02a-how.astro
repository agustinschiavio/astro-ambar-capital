---
---

<section id="HowD" class="relative bg-white" style="height: 130vh;">

  <div class="sticky top-0 h-screen flex flex-col items-center justify-center overflow-hidden px-8">

    <h2 class="font-heading text-4xl md:text-5xl font-light text-white tracking-tight text-center mb-12">
      Cómo diseñamos el viaje
    </h2>

    <div class="hidden md:block w-full max-w-5xl">
      <svg id="howd-svg" viewBox="0 0 900 240" xmlns="http://www.w3.org/2000/svg" class="w-full overflow-visible">

        <!-- Ghost path -->
        <path d="M 850,148 C 700,55 540,230 360,148 C 210,80 160,190 92,148"
          fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="3" stroke-dasharray="8 6"/>

        <!-- Amber route (draws phase 2, right→left) -->
        <path id="howd-path"
          d="M 850,148 C 700,55 540,230 360,148 C 210,80 160,190 92,148"
          fill="none" stroke="#A46B3C" stroke-width="2.5" opacity="0.6" stroke-linecap="round"/>

        <!-- Destination LEFT -->
        <circle id="howd-dest-glow" cx="92" cy="148" r="48" fill="#A46B3C" opacity="0"/>
        <circle cx="92" cy="148" r="28" fill="#0E1A26" stroke="rgba(164,107,60,0.2)" stroke-width="2"/>
        <circle id="howd-dest-ring" cx="92" cy="148" r="28" fill="none" stroke="#A46B3C" stroke-width="2" opacity="0" style="transition: opacity 0.8s;"/>
        <text x="92" y="156" text-anchor="middle" font-size="20" fill="#A46B3C" opacity="0.2" id="howd-flag-dim">⚑</text>
        <text x="92" y="156" text-anchor="middle" font-size="20" fill="#A46B3C" id="howd-flag-bright" style="opacity:0; transition: opacity 0.8s;">⚑</text>

        <!-- Callout 1 — above destination, visible from start -->
        <g id="howd-s1" style="opacity:1; transition: opacity 0.8s ease;">
          <line x1="92" y1="116" x2="92" y2="121" stroke="#A46B3C" stroke-width="1" opacity="0.4"/>
          <text x="92" y="106" text-anchor="middle" font-size="9" fill="#A46B3C" font-family="sans-serif" letter-spacing="2.5" font-weight="700">1 · DIAGNÓSTICO</text>
          <text x="92" y="89" text-anchor="middle" font-size="16" fill="rgba(255,255,255,0.9)" font-family="sans-serif" font-weight="300">Entendemos tus objetivos</text>
        </g>

        <!-- Car -->
        <g id="howd-car" style="opacity:0; transition: opacity 0.6s ease;">
          <rect x="-28" y="-10" width="56" height="18" rx="5" fill="#A46B3C" opacity="0.9"/>
          <rect x="-14" y="-22" width="32" height="15" rx="3" fill="#A46B3C" opacity="0.55"/>
          <circle cx="-16" cy="10" r="7" fill="#0E1A26" stroke="#A46B3C" stroke-width="2"/>
          <circle cx="18" cy="10" r="7" fill="#0E1A26" stroke="#A46B3C" stroke-width="2"/>
        </g>

        <!-- Callout 2 — center, phase 2 -->
        <g id="howd-s2" style="opacity:0; transition: opacity 0.8s ease;">
          <text x="460" y="93" text-anchor="middle" font-size="9" fill="#A46B3C" font-family="sans-serif" letter-spacing="2.5" font-weight="700">2 · ESTRATEGIA</text>
          <text x="460" y="76" text-anchor="middle" font-size="16" fill="rgba(255,255,255,0.9)" font-family="sans-serif" font-weight="300">Diseñamos el viaje</text>
        </g>

        <!-- Callout 3 — right, phase 3 -->
        <g id="howd-s3" style="opacity:0; transition: opacity 0.8s ease;">
          <text x="820" y="192" text-anchor="middle" font-size="9" fill="#A46B3C" font-family="sans-serif" letter-spacing="2.5" font-weight="700">3 · EJECUCIÓN</text>
          <text x="820" y="209" text-anchor="middle" font-size="16" fill="rgba(255,255,255,0.9)" font-family="sans-serif" font-weight="300">Manejamos al destino</text>
        </g>

      </svg>
    </div>

    <!-- Mobile -->
    <div class="md:hidden w-full max-w-sm">
      <div class="flex flex-col divide-y divide-white/8">
        <div class="flex items-start gap-5 py-6">
          <span class="text-signature-accent text-xl mt-0.5 flex-shrink-0">⚑</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-signature-accent">1 · Diagnóstico</p>
            <p class="font-heading text-xl font-light text-white mt-1">Entendemos tus objetivos</p>
          </div>
        </div>
        <div class="flex items-start gap-5 py-6">
          <span class="text-signature-accent text-xl mt-0.5 flex-shrink-0">→</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-signature-accent">2 · Estrategia</p>
            <p class="font-heading text-xl font-light text-white mt-1">Diseñamos el viaje</p>
          </div>
        </div>
        <div class="flex items-start gap-5 py-6">
          <span class="text-signature-accent text-xl mt-0.5 flex-shrink-0">◎</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-signature-accent">3 · Ejecución</p>
            <p class="font-heading text-xl font-light text-white mt-1">Manejamos al destino</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    const section    = document.getElementById('HowD');
    const pathEl     = document.getElementById('howd-path');
    const destGlow   = document.getElementById('howd-dest-glow');
    const destRing   = document.getElementById('howd-dest-ring');
    const flagDim    = document.getElementById('howd-flag-dim');
    const flagBright = document.getElementById('howd-flag-bright');
    const car = document.getElementById('howd-car');
    const s1  = document.getElementById('howd-s1');
    const s2  = document.getElementById('howd-s2');
    const s3  = document.getElementById('howd-s3');

    let pathLength = 0;
    let carSmooth  = 0;
    let carTarget  = 0;
    let rafId      = null;

    function init() {
      if (!pathEl) return;
      pathLength = pathEl.getTotalLength();
      pathEl.setAttribute('stroke-dasharray', String(pathLength));
      pathEl.setAttribute('stroke-dashoffset', String(pathLength));
    }

    function lerp(a, b, t) { return a + (b - a) * Math.min(1, Math.max(0, t)); }
    function ph(p, s, e)   { return Math.min(1, Math.max(0, (p - s) / (e - s))); }

    function applyCarPos(dist) {
      if (!pathEl || !car || !pathLength) return;
      const pt  = pathEl.getPointAtLength(dist);
      const pt2 = pathEl.getPointAtLength(Math.min(dist + 12, pathLength));
      const dx  = pt2.x - pt.x;
      const dy  = pt2.y - pt.y;
      // Flip horizontally for direction, small tilt for curve
      const tilt  = Math.atan2(dy, Math.abs(dx)) * 180 / Math.PI;
      const flipX = dx < 0 ? -1 : 1;
      car.setAttribute('transform', `translate(${pt.x},${pt.y}) scale(${flipX},1) rotate(${tilt})`);
    }

    function animateCar() {
      const delta = carTarget - carSmooth;
      carSmooth += delta * 0.1;
      applyCarPos(carSmooth);
      if (Math.abs(delta) > 0.5) {
        rafId = requestAnimationFrame(animateCar);
      } else {
        rafId = null;
      }
    }

    function update() {
      if (!section) return;
      const rect       = section.getBoundingClientRect();
      const scrollable = section.offsetHeight - window.innerHeight;
      const p          = Math.max(0, Math.min(1, -rect.top / scrollable));

      // Phase 1: destination activates
      const p1 = ph(p, 0.05, 0.32);
      if (destGlow)    destGlow.setAttribute('opacity',  String(lerp(0, 0.14, p1)));
      if (destRing)    destRing.setAttribute('opacity',  String(lerp(0, 1, p1)));
      if (flagDim)     flagDim.setAttribute('opacity',   String(lerp(0.2, 0, p1)));
      if (flagBright)  flagBright.style.opacity = String(lerp(0, 1, p1));

      // Phase 2: route draws right→left + car appears at start (right)
      const p2 = ph(p, 0.32, 0.65);
      if (pathEl && pathLength) pathEl.setAttribute('stroke-dashoffset', String(pathLength * (1 - p2)));
      if (car) car.style.opacity = p > 0.34 ? '1' : '0';
      if (s2)  s2.style.opacity  = p > 0.40 ? '1' : '0';

      // Phase 3: car travels to destination — smooth via rAF
      const p3 = ph(p, 0.65, 0.97);
      carTarget = p3 > 0 ? pathLength * p3 : 0;
      if (!rafId) rafId = requestAnimationFrame(animateCar);

      if (s3) s3.style.opacity = p > 0.67 ? '1' : '0';
    }

    init();
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
