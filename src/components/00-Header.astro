---
import { Image } from 'astro:assets';
import logoSrc from '../assets/wordmark-horizontal-icontext.png';

const navItems = [
  { name: 'Por qué Ambar', href: '/#PorQueAmbar' },
  { name: 'Servicios', href: '/#Servicios' },
  { name: 'Cómo trabajamos', href: '/#ComoTrabajamos' },
  { name: 'Contacto', href: '/#Contacto' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-gray-100">
  <div class="container-custom flex items-center h-16">
    <a href="/" class="flex items-center transition-transform duration-300 hover:scale-105 focus:scale-105 focus:outline-none focus:ring-2 focus:ring-signature-accent focus:ring-offset-2 rounded" aria-label="Ambar home">
      <Image src={logoSrc} alt="Ambar Logo" width={140} height={47} class="transition-all duration-300" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center space-x-8 ml-auto" role="navigation" aria-label="Main navigation">
      {navItems.map(item => (
        <a
          href={item.href}
          class="text-typography/60 text-sm tracking-wide hover:text-typography focus:text-typography transition-all duration-300 focus:outline-none rounded px-2 py-1"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <!-- Pill CTA -->
    <a href="https://calendar.app.google/yBvMKcWRFNcZLaH28" target="_blank" class="hidden md:inline-flex ml-8 items-center px-5 py-2.5 rounded-full bg-primary-dark text-white text-sm font-medium hover:bg-primary-dark/80 transition-all duration-300">
      Reservá tu lugar
    </a>

    <div class="flex items-center space-x-4">
      <!-- Mobile Menu Button -->
      <button 
        id="menu-toggle" 
        class="md:hidden flex items-center transition-transform duration-300 focus:outline-none focus:ring-2 focus:ring-signature-accent focus:ring-offset-2 rounded p-1" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Menu -->
  <nav id="mobile-menu" class="hidden md:hidden bg-premium-neutral w-full border-t border-premium-detail" role="navigation" aria-label="Mobile navigation">
    <div class="container-custom py-4 space-y-4">
      {navItems.map((item, index) => (
        <a 
          href={item.href} 
          class="block py-2 px-2 text-typography hover:text-signature-accent focus:text-signature-accent transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-signature-accent focus:ring-offset-2 rounded"
          style={`transition-delay: ${index * 50}ms;`}
        >
          {item.name}
        </a>
      ))}
    </div>
  </nav>
</header>