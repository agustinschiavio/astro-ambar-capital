---
const pillars = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.524.202-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 5.277a6 6 0 01-1.86 6.663M6.75 4.97l-2.62 5.277a6 6 0 001.86 6.663m7.894 6.618a48.11 48.11 0 00-7.486 0" /></svg>`,
    title: "Independencia",
    description: "Buscamos lo mejor para vos, no lo que tenemos en góndola",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
    title: "Alineación",
    description: "Somos tu co-piloto, vamos juntos",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>`,
    title: "Disciplina",
    description: "Trabajamos con proceso, no con emociones",
  },
];
---

<section id="02b-how" class="py-24 bg-premium-neutral relative overflow-hidden">
  <div class="container-custom">

    <div class="max-w-3xl mx-auto text-center mb-14">
      <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight text-primary-dark">Nuestra filosofía</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {pillars.map((p) => (
        <div class="flex flex-col gap-4 rounded-2xl border border-premium-detail bg-transparent p-7">
          <div class="flex items-center gap-3">
            <div class="text-primary-dark flex-shrink-0" set:html={p.icon} />
            <h3 class="font-heading text-xl font-bold text-primary-dark">{p.title}</h3>
          </div>
          <p class="text-typography/60 leading-relaxed text-base">{p.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
