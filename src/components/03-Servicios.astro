---
const services = [
  {
    tag: "Para empresas",
    title: "Corporate Solutions",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="36" height="36"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>`,
    description: "Tu empresa genera valor en su negocio. Nosotros nos aseguramos de que la estructura financiera no lo frene — con soluciones de liquidez, financiamiento y cobertura.",
    bullets: [],
  },
  {
    tag: "Para individuos y familias",
    title: "Wealth Management",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="36" height="36"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>`,
    description: "No empezamos por el mercado. Empezamos por vos — tus objetivos, tu horizonte, lo que no podés permitirte perder. Las inversiones son el vehículo. El destino lo definís vos.",
    bullets: [
      "Diagnóstico patrimonial y planificación de liquidez",
      "Estrategia de portfolio alineada a tus objetivos de vida",
      "Monitoreo continuo y ajuste ante cambios de mercado o circunstancias personales",
    ],
  },
];
---

<section id="Servicios" class="py-32 bg-premium-neutral relative overflow-hidden">
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight">Servicios</h2>
      <p class="mt-4 text-lg text-gray-500">
        Dos áreas de foco. Un mismo enfoque.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((service, index) => (
        <div class="bg-white rounded-xl p-10 border border-premium-detail group hover:border-signature-accent/30 transition-all duration-500">
          <span class="inline-block text-xs font-semibold uppercase tracking-widest text-primary-dark mb-4">{service.tag}</span>
          <div class="flex items-start gap-5 mb-6">
            <div class="text-signature-accent flex-shrink-0 mt-1" set:html={service.icon} />
            <div>
              <h3 class="font-heading text-3xl font-semibold tracking-tight group-hover:text-signature-accent transition-colors duration-300">{service.title}</h3>
              <p class="mt-2 text-gray-600">{service.description}</p>
            </div>
          </div>
          {service.bullets.length > 0 && (
            <ul class="space-y-3">
              {service.bullets.map((bullet) => (
                <li class="flex items-start gap-3 text-gray-600">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-signature-accent flex-shrink-0"></span>
                  {bullet}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>