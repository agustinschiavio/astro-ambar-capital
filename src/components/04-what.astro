---

<section id="GPI" class="py-24 bg-primary-dark relative overflow-hidden">

  <div class="absolute inset-0 opacity-[0.025]" style="background-image: radial-gradient(circle at 1px 1px, #F4F1EC 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="container-custom relative">

    <!-- Persona view -->
    <div class="persona-view">
      <div class="mb-14 text-center">
        <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight text-premium-neutral leading-tight">
          Gestión Patrimonial Integral <span class="italic text-premium-neutral/50"> · El viaje</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mx-auto">
        {personaQuadrants.map((q) => (
          <div class="flex flex-col gap-3 rounded-2xl border border-white/10 px-6 py-7">
            <div class="flex items-center gap-3">
              <div class="text-premium-neutral flex-shrink-0" set:html={q.icon} />
              <p class="font-heading text-xl font-bold text-premium-neutral">{q.sub}</p>
            </div>
            <p class="font-heading text-base font-light italic text-premium-neutral/60">{q.label}</p>
            <p class="text-premium-neutral/65 text-base leading-relaxed">{q.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <span class="text-premium-neutral/50 text-sm">Sumamos herramientas para el camino:</span>
        <span class="text-premium-neutral/60 text-sm">Optimización impositiva <span class="font-heading italic text-premium-neutral/40"> · Peajes</span></span>
        <span class="text-premium-neutral/60 text-sm">Gestión de riesgo <span class="font-heading italic text-premium-neutral/40"> · Seguros</span></span>
      </div>
    </div>

    <!-- Empresa view -->
    <div class="empresa-view hidden">
      <div class="mb-14 text-center">
        <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight text-premium-neutral leading-tight">
          Asesoría Financiera Empresarial <span class="italic text-premium-neutral/50"> · El viaje</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mx-auto">
        {empresaQuadrants.map((q) => (
          <div class="flex flex-col gap-3 rounded-2xl border border-white/10 px-6 py-7">
            <div class="flex items-center gap-3">
              <div class="text-premium-neutral flex-shrink-0" set:html={q.icon} />
              <p class="font-heading text-xl font-bold text-premium-neutral">{q.sub}</p>
            </div>
            <p class="font-heading text-base font-light italic text-premium-neutral/60">{q.label}</p>
            <p class="text-premium-neutral/65 text-base leading-relaxed">{q.detail}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <span class="text-premium-neutral/50 text-sm">Sumamos herramientas para el camino:</span>
        <span class="text-premium-neutral/60 text-sm">Optimización impositiva <span class="font-heading italic text-premium-neutral/40"> · Peajes</span></span>
      </div>
    </div>

  </div>
</section>
