---
const quadrants = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" /></svg>`,
    label: "La ruta",
    sub: "El plan",
    detail: "Tiempo, aportes e hitos intermedios",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>`,
    label: "El vehículo",
    sub: "La estructura",
    detail: "Personal, sociedad o trust",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>`,
    label: "El combustible",
    sub: "Las inversiones",
    detail: "Bonos, acciones, fondos, commodities",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" /></svg>`,
    label: "Los proveedores",
    sub: "Brokers",
    detail: "Supermercado de productos financieros",
  },
];
---

<section id="Servicios" class="py-24 bg-primary-dark relative overflow-hidden">

  <div class="absolute inset-0 opacity-[0.025]" style="background-image: radial-gradient(circle at 1px 1px, #F4F1EC 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="container-custom relative">

    <!-- Title -->
    <div class="mb-14 text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-light tracking-tight text-premium-neutral leading-tight">
        Gestión Patrimonial Integral <span class="italic text-premium-neutral/50"> · El viaje</span>
      </h2>
    </div>

    <!-- 4 columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mx-auto">
      {quadrants.map((q) => (
        <div class="flex flex-col gap-3 rounded-2xl border border-white/10 px-6 py-7">
          <div class="text-premium-neutral/60" set:html={q.icon} />
          <div>
            <p class="text-premium-neutral font-medium text-base">
              {q.sub}<span class="font-heading font-light italic text-premium-neutral/50"> · {q.label}</span>
            </p>
          </div>
          <p class="text-premium-neutral/40 text-sm leading-relaxed">{q.detail}</p>
        </div>
      ))}
    </div>

    <!-- Footer line -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      <span class="text-premium-neutral/40 text-sm">Sumamos herramientas para el camino:</span>
      <span class="text-premium-neutral/50 text-sm">Optimización impositiva <span class="font-heading italic text-premium-neutral/35"> · Peajes</span></span>
      <span class="text-premium-neutral/50 text-sm">Gestión de riesgo <span class="font-heading italic text-premium-neutral/35"> · Seguros</span></span>
    </div>

  </div>
</section>
